# Copy this file to ".env" and paste your real keys.
# NEVER commit .env or share these keys.

# Brain + Ears + Mouth — OpenAI Realtime (gpt-realtime), key from platform.openai.com
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime

# (optional) Azure OpenAI instead of OpenAI: set the endpoint and the app switches to Azure.
# REALTIME_MODEL is then your Azure deployment name.
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com

# (optional) Deepgram — only if you want a second on-screen transcript later
DEEPGRAM_API_KEY=
